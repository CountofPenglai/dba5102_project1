{
  "version": "models_v1",
  "window_days": 30,
  "min_train_rows": 30,
  "seed": 42,
  "features": ["option_type", "remaining_seconds", "log_moneyness", "market_price_usdc_per_btc", "realized_vol_60m", "realized_vol_1440m", "log_return_60m"],
  "models": {
    "gam": {"n_splines": 6, "lam": 10.0, "max_iter": 100, "tol": 0.0001},
    "ebm": {"max_bins": 32, "max_interaction_bins": 8, "learning_rate": 0.03, "max_rounds": 500, "min_samples_leaf": 20, "reg_lambda": 10.0, "smoothing_rounds": 50, "interaction_smoothing_rounds": 50, "interactions": [["realized_vol_60m", "remaining_seconds"], ["option_type", "log_return_60m"]]},
    "shallow_gbdt": {"max_depth": 3, "max_leaf_nodes": 8, "max_iter": 150, "learning_rate": 0.03, "min_samples_leaf": 20, "l2_regularization": 10.0}
  }
}
