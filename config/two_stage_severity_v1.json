{
  "version": "two_stage_severity_v1",
  "protocol": "config/validation_protocol_v2.json",
  "models": ["official_raw", "grouped_mean", "direction_scaled", "h0", "g0", "g1a", "g1b"],
  "severity_candidates": {
    "h0": {"kind": "positive_base_least_squares", "alpha": null},
    "g0": {"kind": "positive_ratio_mean", "alpha": null},
    "g1a": {"kind": "gamma_log_link", "alpha": 1.0},
    "g1b": {"kind": "gamma_log_link", "alpha": 10.0}
  },
  "features": ["log_remaining_seconds", "aligned_volatility_position"],
  "minimum_positive_orders": 40,
  "minimum_creation_days": 5,
  "standardized_clip": 3.0,
  "aligned_position_clip": 5.0,
  "tail_quantile": 0.9,
  "tail_minimum_history": 30,
  "risk_tolerance_vs_base": 1.02,
  "group_smoothing": 30,
  "hurdle_logistic_C": 0.1,
  "selection": {
    "macro_rmse_strictly_below_h0": true,
    "macro_mae_not_above_h0": true,
    "risk_constraints_are_working_proposal": true
  }
}
