{
  "version": "validation_study_v1",
  "cohort": "risk",
  "use_base": false,
  "threads": 1,
  "rmse_tolerance": 0.01,
  "baseline_smoothing": 30,
  "periods": {
    "tuning": ["2026-06-01T00:00:00Z", "2026-06-21T00:00:00Z"],
    "confirmation": ["2026-06-21T00:00:00Z", "2026-07-01T00:00:00Z"]
  },
  "stages": {
    "gam": [
      {"parameter": "lam", "values": [10.0, 1.0, 100.0]},
      {"parameter": "n_splines", "values": [6, 4, 8]}
    ],
    "ebm": [
      {"parameter": "min_samples_leaf", "values": [20, 40, 80]},
      {"parameter": "max_rounds", "values": [500, 200, 1000]},
      {"parameter": "interactions", "values": [
        [["realized_vol_60m", "remaining_seconds"], ["option_type", "log_return_60m"]],
        []
      ]}
    ],
    "shallow_gbdt": [
      {"parameter": "max_depth", "values": [3, 2]},
      {"parameter": "min_samples_leaf", "values": [20, 40, 80]},
      {"parameter": "max_iter", "values": [150, 75, 300]}
    ]
  },
  "seconds_per_fit_assumption": {
    "gam": [0.1, 3.0],
    "ebm": [0.5, 15.0],
    "shallow_gbdt": [0.1, 3.0]
  }
}
